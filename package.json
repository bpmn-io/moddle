{
  "name": "moddle",
  "version": "8.0.0",
  "description": "A library for importing meta-model based file formats into JS",
  "scripts": {
    "all": "run-s lint test test:schema",
    "lint": "eslint .",
    "pretest": "run-s build",
    "dev": "npm test -- --watch",
    "test": "mocha --reporter=spec --recursive test",
    "test:schema": "ajv -s resources/schema/moddle.json -d 'test/fixtures/**/*.json'",
    "build": "rollup -c --bundleConfigAsCjs",
    "prepare": "run-s build"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bpmn-io/moddle"
  },
  "keywords": [
    "model",
    "meta-model",
    "xml",
    "xsd",
    "import",
    "export"
  ],
  "author": {
    "name": "Nico Rehwaldt",
    "url": "https://github.com/Nikku"
  },
  "contributors": [
    {
      "name": "bpmn.io contributors",
      "url": "https://github.com/bpmn-io"
    }
  ],
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-cli": "^5.0.0",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "eslint-plugin-bpmn-io": "^2.2.0",
    "fast-glob": "^3.3.3",
    "mocha": "^11.7.5",
    "npm-run-all2": "^8.0.4",
    "rollup": "^4.54.0"
  },
  "dependencies": {
    "min-dash": "^5.0.0"
  },
  "files": [
    "dist",
    "resources/schema/moddle.json"
  ]
}
